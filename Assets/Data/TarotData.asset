  - Type: 1
    Sprite: {fileID: 5582538922163030596, guid: 5d2a8341fcaf045d28c1cce682344e55, type: 3}
    Name: "\u30DA\u30F3\u30BF\u30AF\u30EB\u306E\u30A8\u30FC\u30B9"
    Description: "\u5927\u5730\u304B\u3089\u5DEE\u3057\u51FA\u3055\u308C\u305F\u6700\u521D\u306E\u91D1\u8CA8\u306F\u3001\u307E\u3060\u5C0F\u3055\u304F\u3066\u3082\u78BA\u304B\u306A\u82BD\u3092\u8C61\u5FB4\u3059\u308B\u3002\u624B\u306E\u3072\u3089\u306B\u30DD\u30F3\u3068\u843D\u3061\u308B\u6075\u307F\u306F\u3001\u660E\u65E5\u3078\u306E\u4E00\u6B69\u3092\u7167\u3089\u3059\u3002\n\n\u3053\u306E\u672D\u304C\u958B\u304B\u308C\u305F\u77AC\u9593\u306B\u30B3\u30A4\u30F3\u304C100\u5897\u3048\u308B\u3002\u6025\u306A\u51FA\u8CBB\u306B\u3082\u5099\u3048\u3089\u308C\u308B\u3001\u307E\u3055\u306B\u300C\u624B\u5143\u306E\u8D08\u308A\u7269\u300D\u3060\u3002"
  - Type: 2
    Sprite: {fileID: 5716527379724214676, guid: 83e80192af5b045329e287e48d5aa665, type: 3}
    Name: "\u5973\u5E1D"
    Description: "\u8C4A\u7A63\u306E\u5EAD\u3092\u6CBB\u3081\u308B\u5973\u5E1D\u306F\u3001\u5275\u9020\u3068\u6075\u307F\u304C\u5FAA\u74B0\u3057\u7D9A\u3051\u308B\u8C4A\u304B\u3055\u3092\u8868\u3059\u3002\u82B1\u306F\u54B2\u304D\u3001\u53CE\u7A6B\u306F\u5C3D\u304D\u306A\u3044\u3002\n\n\u3053\u306E\u52B9\u679C\u304C\u7D9A\u304F\u4E09\u65E5\u9593\u3001\u30AE\u30E3\u30E9\u30EA\u30FC\u304B\u3089\u5F97\u3089\u308C\u308B\u3059\u3079\u3066\u306E\u53CE\u76CA\u304C\u500D\u306B\u306A\u308B\u3002\u65E5\u3005\u306E\u58F2\u4E0A\u3068\u30EC\u30F3\u30BF\u30EB\u304C\u91CD\u306A\u308B\u307B\u3069\u3001\u305D\u306E\u5DEE\u306F\u5927\u304D\u304F\u80B2\u3064\u3002"
  - Type: 3
    Sprite: {fileID: 6800298464817200478, guid: 12b32890a32254680a48a77360875005, type: 3}
    Name: "\u30DA\u30F3\u30BF\u30AF\u30EB\u306E\uFF11\uFF10"
    Description: "\u4EE3\u3005\u3064\u306A\u304C\u308B\u7E41\u6804\u3068\u3001\u5BB6\u3068\u8CA1\u306E\u7269\u8A9E\u304C\u4E00\u679A\u306B\u53CE\u307E\u308B\u3002\u7A4D\u307F\u4E0A\u3052\u3089\u308C\u305F\u4FA1\u5024\u306F\u3001\u4F5C\u54C1\u306B\u3082\u9759\u304B\u306B\u5BBF\u308B\u3002\n\n\u4E09\u65E5\u9593\u3001\u4F5C\u54C1\u306E\u57FA\u790E\u4FA1\u5024\u304C
      10\uFF05 \u9AD8\u304F\u306A\u308B\u3002\u6642\u9593\u3092\u304B\u3051\u3066\u80B2\u3066\u305F\u7D75\u304C\u3001\u5C11\u3057\u3060\u3051\u9AD8\u304F\u8A55\u4FA1\u3055\u308C\u308B\u5B63\u7BC0\u304C\u8A2A\u308C\u308B\u3002"
  - Type: 4
    Sprite: {fileID: 693195512843694964, guid: ed81821c5757b4e43bedf31ba18aed0d, type: 3}
    Name: "\u904B\u547D\u306E\u8F2A"
    Description: "\u8F2A\u306F\u56DE\u308A\u3001\u5076\u7136\u3068\u5FC5\u7136\u304C\u4EA4\u5DEE\u3059\u308B\u3002\u4ECA\u591C\u306E\u30AE\u30E3\u30E9\u30EA\u30FC\u306B\u8AB0\u304C\u8DB3\u3092\u8E0F\u307F\u5165\u308C\u308B\u304B\u306F\u3001\u904B\u547D\u306E\u6B6F\u8ECA\u306B\u59D4\u306D\u3089\u308C\u308B\u3002\n\n\u7FCC\u65E5\u304C\u59CB\u307E\u308B\u307E\u3067\u3001\u8CC3\u8CB8\u304C\u6210\u7ACB\u3059\u308B\u78BA\u7387\u304C\u500D\u306B\u306A\u308B\u3002\u307E\u3060\u8AB0\u3082\u6765\u3066\u3044\u306A\u304F\u3066\u3082\u3001\u95A2\u5FC3\u306E\u71B1\u306F\u9759\u304B\u306B\u9AD8\u307E\u3063\u3066\u3044\u308B\u3002"
  - Type: 5
    Sprite: {fileID: 4626540226026732118, guid: b500692c68e864e3fbf5bfdafd4223a4, type: 3}
    Name: "\u9B54\u8853\u5E2B"
    Description: "\u673A\u306E\u4E0A\u306E\u56DB\u5143\u7D20\u3092\u64CD\u308B\u9B54\u8853\u5E2B\u306F\u3001\u610F\u5FD7\u3092\u5F62\u306B\u5909\u3048\u308B\u8853\u58EB\u3060\u3002\u4ECA\u65E5\u306F\u5275\u308B\u307B\u3069\u306B\u4F53\u304C\u8EFD\u304F\u3001\u7B46\u304C\u6B62\u307E\u3089\u306A\u3044\u3002\n\n\u305D\u306E\u65E5\u9650\u308A\u3001\u82B8\u8853\u3092\u5275\u308B\u3068\u304D\u75B2\u52B4\u304C\u6E1B\u3089\u306A\u3044\uFF08\u5275\u4F5C\u306B\u75B2\u52B4\u30B3\u30B9\u30C8\u304C\u304B\u304B\u3089\u306A\u3044\uFF09\u3002\u4E00\u65E5\u306E\u3046\u3061\u306B\u3001\u3044\u3064\u3082\u3088\u308A\u591A\u304F\u63CF\u3051\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u3002"
  - Type: 6
    Sprite: {fileID: -8172750967290911234, guid: 1920f84765a9649e290f7a936a42e032, type: 3}
    Name: "\u661F"
    Description: "\u591C\u306E\u95C7\u306E\u3042\u3068\u306B\u5DEE\u3059\u661F\u306F\u3001\u5E0C\u671B\u3068\u6D44\u5316\u306E\u6C34\u3092\u6CE8\u3050\u3002\u50B7\u3064\u3044\u305F\u5FC3\u3082\u4F53\u3082\u3001\u9759\u304B\u306B\u6E80\u305F\u3055\u308C\u308B\u3002\n\n\u958B\u3044\u305F\u77AC\u9593\u306B\u75B2\u52B4\u304C\u3059\u3079\u30660\u306B\u623B\u308B\u3002\u9650\u754C\u307E\u3067\u8D70\u3063\u305F\u3042\u3068\u306E\u3001\u3055\u3055\u3084\u304B\u306A\u56DE\u5FA9\u306E\u5947\u8DE1\u3060\u3002"
  - Type: 7
    Sprite: {fileID: 6800298464817200478, guid: 12b32890a32254680a48a77360875005, type: 3}
    Name: "\u30DA\u30F3\u30BF\u30AF\u30EB\u306E\uFF12"
    Description: "\u6CE2\u306E\u4E0A\u3067\u4E8C\u3064\u306E\u5186\u74B0\u3092\u3064\u306A\u304E\u3001\u63FA\u308C\u306A\u304C\u3089\u3082\u5747\u8861\u3092\u4FDD\u3064\u8005\u3002\n\u5929\u5730\u306F\u9759\u304B\u306B\u91E3\u308A\u5408\u3044\u3001\u4F55\u3082\u8D77\u3053\u3089\u306A\u3044\u3002\n\u305D\u306E\u9759\u3051\u3055\u304C\u3001\u6B21\u306E\u4E00\u624B\u3092\u9078\u3076\u305F\u3081\u306E\u4F59\u767D\u3068\u306A\u308B\u3002"
  - Type: 8
    Sprite: {fileID: 7160320624361502491, guid: 501ca010916fb4572b7c17dc46eeeac5, type: 3}
    Name: "\u96A0\u8005"
    Description: "\u5C71\u9802\u3067\u706F\u308A\u3092\u63B2\u3052\u308B\u96A0\u8005\u306F\u3001\u5916\u3067\u306F\u306A\u304F\u5185\u5074\u306E\u58F0\u3092\u983C\u308A\u306B\u6B69\u3080\u3002\u4E16\u754C\u306F\u4ECA\u65E5\u3001\u5275\u4F5C\u304B\u3089\u624B\u3092\u5F15\u304F\u6642\u9593\u3092\u6C42\u3081\u3066\u3044\u308B\u3002\n\n\u305D\u306E\u65E5\u306F\u65B0\u3057\u3044\u4F5C\u54C1\u3092\u5275\u308C\u306A\u3044\uFF08\u5275\u4F5C\u30D6\u30ED\u30C3\u30AF\uFF09\u3002\u4F11\u3080\u3053\u3068\u3082\u3001\u4F5C\u54C1\u306E\u305F\u3081\u306E\u5927\u5207\u306A\u4E00\u65E5\u3060\u3002"
  - Type: 9
    Sprite: {fileID: 6931650692401310986, guid: 8b1cae51521b648559abb3dc2f58cec0, type: 3}
    Name: 
    Description: "\u5D16\u306E\u7E01\u3067\u8EFD\u3084\u304B\u306B\u6B69\u304F\u611A\u8005\u306F\u3001\u843D\u3061\u308B\u304B\u98DB\u3076\u304B\u307E\u3060\u308F\u304B\u3089\u306A\u3044\u4E00\u6B69\u3092\u8C61\u5FB4\u3059\u308B\u3002\u6CB9\u65AD\u3057\u305F\u4E00\u6B69\u304C\u3001\u4FA1\u683C\u306B\u5F71\u3092\u843D\u3068\u3059\u3002\n\n\u6B21\u306B\u5B8C\u6210\u3059\u308B\u4E09\u4F5C\u54C1\u306E\u57FA\u790E\u4FA1\u5024\u304C 
