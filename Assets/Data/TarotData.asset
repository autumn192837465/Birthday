  - Type: 10
    Sprite: {fileID: -2179831516796529827, guid: 9279a008aa29c4a77b5967e2b40bbcba, type: 3}
    Name: "\u540A\u308B\u3055\u308C\u305F\u7537"
    Description: "\u9006\u3055\u307E\u306E\u8996\u70B9\u3067\u4E16\u754C\u3092\u773A\u3081\u308B\u8005\u306F\u3001\u72A0\u7272\u3068\u5F85\u6A5F\u306E\u6642\u9593\u3092\u9078\u3076\u3002\u843D\u3061\u305F\u3082\u306E\u306F\u5C0F\u3055\u304F\u3001\u5FC3\u3078\u306E\u68D8\u306F\u6D45\u3044\u3002\n\n\u6240\u6301\u91D1\u304B\u3089\u6700\u592720\u30B3\u30A4\u30F3\u304C\u5373\u5EA7\u306B\u5F15\u304B\u308C\u308B\uFF08\u6240\u6301\u304C\u305D\u308C\u4EE5\u4E0B\u306A\u3089\u305D\u306E\u7BC4\u56F2\uFF09\u3002\u5927\u304D\u306A\u7834\u7523\u3067\u306F\u306A\u3044\u304C\u3001\u30DD\u30B1\u30C3\u30C8\u306F\u8EFD\u304F\u306A\u308B\u3002"
  - Type: 11
    Sprite: {fileID: 7160320624361502491, guid: 501ca010916fb4572b7c17dc46eeeac5, type: 3}
    Name: "\u6708"
    Description: "\u6708\u306F\u5922\u3068\u5E7B\u5F71\u3001\u9053\u3092\u8FF7\u308F\u305B\u308B\u5149\u3092\u653E\u3064\u3002\u4ECA\u591C\u306F\u5BA2\u8DB3\u304C\u5F71\u306B\u7D1B\u308C\u3001\u8208\u5473\u304C\u9727\u306B\u6EB6\u3051\u308B\u3002\n\n\u305D\u306E\u591C\u306E\u5E02\u5834\u51E6\u7406\u304C\u7D42\u308F\u308B\u307E\u3067\uFF08\u7FCC\u65E5\u306B\u9032\u3080\u307E\u3067\uFF09\u3001\u8CC3\u8CB8\u304C\u6210\u7ACB\u3059\u308B\u78BA\u7387\u304C\u534A\u5206\u306B\u306A\u308B\u3002\u60AA\u622F\u597D\u304D\u306E\u5E7D\u970A\u304C\u3001\u4E00\u6669\u3060\u3051\u8DB3\u97F3\u3092\u6D88\u3057\u305F\u3088\u3046\u306A\u591C\u3060\u3002"
