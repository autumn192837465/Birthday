    Price: 0
  - Type: 2
    Name: Just being with you
    Description: "\u98FC\u3044\u732B\u304C\u6C17\u6301\u3061\u3088\u3055\u305D\u3046\u306B\u7720\u3063\u3066\u3044\u308B\u3068\u304D\u3001\u305F\u307E\u3089\u306A\u304F\u611B\u304A\u3057\u3044\u6C17\u6301\u3061\u306B\u306A\u308A\u307E\u3059\u3002\u305D\u306E\u59FF\u304C\u3001\u79C1\u306B\u3068\u3063\u3066\u305F\u3060\u305D\u3053\u306B\u3044\u3066\u304F\u308C\u308B\u3060\u3051\u3067\u5E78\u305B\u3092\u611F\u3058\u308B\u611B\u306E\u5B58\u5728\u3067\u3042\u308B\u3053\u3068\u3092\u8868\u73FE\u3057\u307E\u3057\u305F\u3002"
    Sprite: {fileID: -1399983992106746050, guid: cd9cfa75b92b85842ba4440df90ca55a, type: 3}
    Price: 0
  - Type: 3
    Name: first day of spring
    Description: "\u6625\u306E\u306F\u3058\u307E\u308A\u306F\u3001\u79C1\u306E\u4E2D\u3067\u3082\u3063\u3068\u3082\u5FC3\u8E8D\u308B\u3068\u304D\u3067\u3059\u3002\u51FA\u4F1A\u3044\u3068\u5225\u308C\u306E\u6642\u671F\u306B\u611F\u3058\u308B\u5207\u306A\u3055\u3084\u511A\u3055\u3001\u308F\u304F\u308F\u304F\u611F\u3092\u7D75\u753B\u3067\u8868\u73FE\u3057\u307E\u3057\u305F\u3002
      \u67D4\u3089\u304B\u3067\u7E4A\u7D30\u306A\u8272\u306E\u91CD\u306A\u308A\u304C\u7279\u5FB4\u3067\u3001
